{
  "appId": "space.pokerdojo.app",
  "appName": "Poker Dojo",
  "webDir": "www",
  "server": {
    "url": "https://pokerdojo.space",
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "launchFadeOutDuration": 300,
      "backgroundColor": "#2f4a3e",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": false
    }
  }
}
