# 牌谱数据（运行时生成，勿入库/勿覆盖）
PokerServer/hands.jsonl

# 桌内临时语音（1 小时过期，无历史、不备份）
PokerServer/voice_tmp/

# JWT 私章（每台服务器自动生成、唯一，绝不入库/勿覆盖）
PokerServer/secret.key

# 发信 SMTP 凭据（授权码，绝不入库/勿覆盖）
PokerServer/mail.json
# 部署时生成的版本戳（每次都不同，不入库；但会打进部署包）
PokerServer/build-info.json
PokerServer/.local/
backups_offsite/

# 本地私有文档与脚本（不入库，仅本地）
# 仓库是 public：任何运维相关的内容一律用 *.local.md 命名，自动被忽略。
*.local.md
backup-hk.sh
# 运维脚本目录（部署在服务器上，不随仓库分发）
# 🔴 必须带前导斜杠锚在仓库根：不带的话 `ops/` 会匹配【任意深度】的同名目录，
#    2026-09-16 就这么把新写的 PokerServer/src/ops/（崩溃告警 + 客户端报错两个模块）
#    整个吞掉了 —— git status 里根本不显示，本机跑得好好的，
#    一提交就是 CI MODULE_NOT_FOUND、换台机器 clone 下来服务起不来。
/ops/
PokerServer/ops/

# ⚠️ 这行原本是两条规则被粘成了一行（丢了个换行），于是【两条都失效】：
#    PokerServer/.local/ 另有一条兜着，但 data.json.localbak 就这么一直没被忽略着。
#    它是用户库（账号/金币）的备份，而本仓库是 public —— 不能漏。
PokerServer/data.json.localbak

# 签名密钥（APK 固定签名，绝不入库；base64 副本贴进 GitHub Secrets）
.secrets/
